        "groups": [
          {
            "group": "Trust & Security",
            "pages": [
              "security/overview"
            ]
          },
          {
            "group": "AitriumOS · Desktop App",
            "icon": "square-terminal",
            "pages": [
              "security/aitrium-os/overview",
              "security/aitrium-os/architecture",
              "security/aitrium-os/data-flows",
              "security/aitrium-os/access-management"
            ]
          },
          {
            "group": "RTQA appliance",
            "icon": "server-cog",
            "pages": [
              "security/rtqa-appliance/overview",
              "security/rtqa-appliance/architecture",
              "security/rtqa-appliance/data-flows",
              "security/rtqa-appliance/access-management",
