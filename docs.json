{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Aitrium Documentation",
  "colors": {
    "primary": "#0052CC",
    "light": "#2684FF",
    "dark": "#0052CC"
  },
  "fonts": {
    "family": "Reddit Sans"
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "favicon": "/favicon.svg",
