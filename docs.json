        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction"
            ]
          },
          {
            "group": "AitriumOS",
            "icon": "square-terminal",
            "pages": [
              "aitrium-os/overview",
              "aitrium-os/no-protocol-submissions",
              "aitrium-os/protocol-submissions"
            ]
          },
          {
            "group": "Trial Accelerator",
            "icon": "component",
            "pages": [
              "trial-accelerator/overview",
              "trial-accelerator/creating-protocol-trials",
              "trial-accelerator/advanced-configuration"
            ]
          },
          {
            "group": "Aitrium Admin",
            "icon": "settings",
            "pages": [
              "aitrium-admin/overview",
              "aitrium-admin/user-management",
              "aitrium-admin/network-management",
              "aitrium-admin/audit-logging",
              "aitrium-admin/integrations"
            ]
          }
        ]
      },
      {
        "tab": "Training",
        "icon": "graduation-cap",
        "groups": [
          {
            "group": "Data Submission Training",
            "pages": [
              "training/basic-submission",
              "training/rtqa-submission"
            ]
          }
        ]
      },
      {
        "tab": "Trust & Security",
        "icon": "shield-check",
        "groups": [
          {
            "group": "Trust & Security",
            "pages": [
              "security/overview"
            ]
          },
          {
            "group": "AitriumOS · Desktop App",
            "icon": "square-terminal",
            "pages": [
              "security/aitrium-os/overview",
              "security/aitrium-os/architecture",
              "security/aitrium-os/data-flows",
              "security/aitrium-os/access-management",
              "security/aitrium-os/deployment",
              "security/aitrium-os/validation"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "openapi": {
          "source": "openapi.yaml"
        }
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
