            ]
          },
          {
            "group": "Submitting data",
            "icon": "upload",
            "pages": [
              "aitrium-os/no-protocol-submissions",
              "aitrium-os/protocol-submissions"
            ]
          },
          {
            "group": "Training",
            "icon": "graduation-cap",
            "pages": [
              "training/basic-submission",
              "training/rtqa-submission"
            ]
          },
          {
            "group": "IT & network",
            "icon": "monitor-cog",
            "pages": [
              "aitrium-os/it-setup",
