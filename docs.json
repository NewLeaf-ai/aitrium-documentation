            ]
          },
          {
            "group": "Organization administration",
            "icon": "settings",
            "pages": [
              "aitrium-admin/overview",
              "aitrium-admin/user-management",
              "aitrium-admin/network-management",
              "aitrium-admin/integrations",
              "aitrium-admin/audit-logging"
            ]
          },
          {
            "group": "SFTP server (for your IT)",
            "icon": "server",
            "pages": [
              "security/aitrium-os/sftp-compatibility"
            ]
          },
          {
            "group": "RTQA appliance (for your IT)",
            "icon": "server-cog",
            "pages": [
              "rtqa-appliance/it-setup",
              "rtqa-appliance/requirements",
              "rtqa-appliance/install",
              "rtqa-appliance/operations",
              "rtqa-appliance/troubleshooting",
              "rtqa-appliance/configuration"
